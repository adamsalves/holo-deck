# Copie para .env e preencha. Nada aqui é lido antes da Fase 7.

# Postgres (Neon) — fonte da verdade do save de quem tem conta.
# São duas rotas para o MESMO banco, e as duas ficam nos dois ambientes.
# Identifique pelo host, não pelo rótulo que o Neon imprime: a do pooler tem
# `-pooler` no hostname.
DATABASE_URL=            # com -pooler: o runtime, que é serverless
DATABASE_URL_UNPOOLED=   # sem -pooler: o drizzle-kit, que roda DDL

# better-auth — biblioteca, não serviço: não há painel nem conta a criar.
# O secret é seu: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Em produção, https://holo-deck.vercel.app. Local é 3100 e não 3000 porque
# nesta máquina a 3000 costuma estar ocupada — rodar `PORT=3100 yarn dev`, a
# mesma porta do e2e. Precisa casar com a redirect URI registrada no GitHub.
BETTER_AUTH_URL=http://localhost:3100
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
